# =============================================================================
# SecureBank platform — environment template.
# Copy to `.env` (which is gitignored) and fill in / override before:
#   docker compose up -d --build
# docker compose automatically reads `.env` from this directory.
# =============================================================================

# ---- Postgres bootstrap superuser (used only by the postgres container) -----
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASSWORD=postgres

# ---- Per-service DB credentials (must match postgres-init/01-init-databases.sql)
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=auth
SECUREBANK_DB_USER=securebank
SECUREBANK_DB_PASSWORD=securebank

# ---- JWT signing secret (REQUIRED — auth-service refuses to start without it) -
# Must be >= 32 bytes for HS256. Generate one with:  openssl rand -base64 48
SECUREBANK_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes-0123456789

# ---- RabbitMQ ---------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ---- Fraud-service AI (optional) --------------------------------------------
# Leave SECUREBANK_AI_API_KEY blank to run the deterministic provider (fully
# offline). Set a real Anthropic key to enable the live Claude path.
SECUREBANK_AI_ENABLED=true
SECUREBANK_AI_API_KEY=
SECUREBANK_AI_MODEL=claude-opus-4-8

# ---- Grafana (observability profile) ----------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
